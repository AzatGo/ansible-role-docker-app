# Managed by Ansible.
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB={{ docker_app_postgres_db | to_json }}
POSTGRES_USER={{ docker_app_postgres_user | to_json }}
POSTGRES_PASSWORD={{ docker_app_postgres_password | to_json(ensure_ascii=False) | replace('$', '$$') }}
APP_NAME={{ docker_app_name | to_json(ensure_ascii=False) | replace('$', '$$') }}
LOG_LEVEL={{ docker_app_log_level | to_json }}
SHUTDOWN_DELAY_SECONDS={{ docker_app_shutdown_delay }}
DB_CONNECT_TIMEOUT={{ docker_app_db_connect_timeout }}
